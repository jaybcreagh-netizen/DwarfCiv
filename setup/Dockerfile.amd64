FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash \
        bzip2 \
        ca-certificates \
        coreutils \
        curl \
        libbz2-1.0 \
        libglu1-mesa \
        libgtk2.0-0t64 \
        libopenal1 \
        libsdl2-2.0-0 \
        libsdl2-image-2.0-0 \
        libstdc++6 \
        python3 \
        python3-pip \
        python3-venv \
        procps \
        zlib1g \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/dwarfciv-requirements.txt
RUN python3 -m pip install --break-system-packages \
        -r /tmp/dwarfciv-requirements.txt

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
CMD ["bash"]
